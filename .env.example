# Copier ce fichier vers .env.local puis renseigner les valeurs.
# Ne jamais commiter .env.local. Ne jamais exposer la service role key au navigateur.

# Projet Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Serveur uniquement. Réservé à la création des comptes staff et au bootstrap.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Jeton à usage unique pour créer le premier administrateur.
# Choisir une valeur longue et aléatoire. Le retirer après le bootstrap si souhaité.
SCENO_SETUP_TOKEN=choose_a_long_random_token

# URL publique du site (liens e-mail de réinitialisation, métadonnées).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
